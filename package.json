{
  "name": "weather-forecast-function",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "deploy:function": "npm run build && gcloud functions deploy weather-forecast --gen2 --region=asia-southeast2 --runtime=nodejs20 --source=. --entry-point=app --trigger-http --memory=1024MB --timeout=60s --min-instances=0 --max-instances=10 --allow-unauthenticated --set-env-vars=NODE_ENV=production --ingress-settings=all"
  },
